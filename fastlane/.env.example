# Copy to fastlane/.env (gitignored) and fill in.
# Path to the Google Play service-account JSON key file.
SUPPLY_JSON_KEY_FILE=./fastlane/play-store-key.json

# Android signing (read by android/app/build.gradle when keystore.properties is absent).
ANDROID_KEYSTORE_FILE=/absolute/path/to/release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=matbex
ANDROID_KEY_PASSWORD=

# Optional: package name override (defaults to Sufra OS Capacitor appId)
# ANDROID_PACKAGE_NAME=app.lovable.6d7e02d671b749c78974833cd1b54c5f

# Set to 1 to dry-run uploads through Google Play API without publishing.
# FASTLANE_VALIDATE_ONLY=1