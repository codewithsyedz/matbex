# ─────────────────────────────────────────────────────────────────────────────
# Matbex — single environment file for docker compose (production) and local dev.
# Copy to .env and fill in. Generate secrets with:  npm --prefix server run keys
# ─────────────────────────────────────────────────────────────────────────────

# ---- Public URLs -------------------------------------------------------------
APP_DOMAIN=app.matbex.com          # web app hostname (Caddy issues TLS automatically)
API_DOMAIN=api.matbex.com          # API hostname
SITE_URL=https://app.matbex.com
API_URL=https://api.matbex.com
# Extra origins allowed for CORS + auth redirects (comma-separated, wildcards ok)
ALLOWED_ORIGINS=https://matbex.com,https://www.matbex.com,https://*.matbex.com

# ---- Web build (baked into the static bundle) -------------------------------
VITE_API_URL=https://api.matbex.com
VITE_API_KEY=                       # = ANON_KEY below (public, role "anon")
# VITE_API_URL_KSA=                 # optional KSA data-residency deployment
# VITE_API_KEY_KSA=
# VITE_PREVIEW_DOMAIN=staging.matbex.com
# VITE_STORAGE_CDN_HOST=https://cdn.matbex.com

# ---- Database -----------------------------------------------------------------
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matbex
DATABASE_URL=postgres://postgres:change-me@db:5432/matbex
AUTHENTICATOR_PASSWORD=             # low-privilege role used by PostgREST

# ---- Auth / keys (npm --prefix server run keys) -------------------------------
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_EXPIRY_SECONDS=3600
AUTH_AUTOCONFIRM=false              # true = skip email confirmation on signup
AUTH_DISABLE_SIGNUP=false
CRON_SECRET=

# ---- Storage ------------------------------------------------------------------
STORAGE_DRIVER=fs                   # fs (docker volume `objects`) | s3 (Cloudflare R2, AWS, MinIO)
S3_ENDPOINT=                        # R2: https://<account>.r2.cloudflarestorage.com; empty for AWS
S3_REGION=us-east-1
S3_BUCKET=matbex
S3_ACCESS_KEY_ID=matbex
S3_SECRET_ACCESS_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# ---- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Matbex <noreply@notify.matbex.com>
EMAIL_FROM_DOMAIN=notify.matbex.com   # domain verified in Resend (mail.matbex.com is delegated to Lovable)
# Staging only: send email ONLY to these addresses / @domains (comma-separated); everything else
# is dropped and logged. Leave empty in production.
EMAIL_ALLOWED_RECIPIENTS=

# ---- AI (Anthropic) -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Integrations used by server functions ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Growth plan (349 SAR/month) Stripe price id; empty = Growth is sold through sales, not online.
STRIPE_PRICE_GROWTH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SEMRUSH_API_KEY=
CKO_PLATFORM_SECRET_KEY=
CKO_PLATFORM_PUBLIC_KEY=
CKO_PLATFORM_PROCESSING_CHANNEL_ID=
CKO_PLATFORM_WEBHOOK_SECRET=
CKO_ENVIRONMENT=sandbox
HALA_MERCHANT_ID=
HALA_API_KEY=
ZATCA_BASE_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Redis (cache + shared rate-limit counters) ---------------------------------
# docker-compose.yml runs Redis and sets REDIS_URL for the API from REDIS_PASSWORD.
REDIS_PASSWORD=change-me-redis
# For running the API outside Docker (local dev: docker-compose.dev.yml exposes 6379):
# REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=matbex:

# ---- Observability (docker-compose.observability.yml, docs/self-hosting/OBSERVABILITY.md)
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# GRAFANA_PORT=3300                  # bound to 127.0.0.1 only
# PROMETHEUS_RETENTION=30d
# For tracing when running the API outside Docker:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_PORT=9464                  # 0 disables /metrics

# ---- Jobs -----------------------------------------------------------------------
JOBS_ENABLED=true
JOBS_TIMEZONE=Asia/Riyadh
# JOB_SCHEDULES_JSON={"send-weekly-digest":"0 8 * * 1"}

# ---- One-time production move (server/scripts/migrate-from-supabase.mjs) ------------
# Only needed on the machine that runs the move; delete afterwards.
# SOURCE_DATABASE_URL=postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# SOURCE_SUPABASE_URL=https://<ref>.supabase.co
# SOURCE_SERVICE_ROLE_KEY=

# Alerts (docs/self-hosting/MONITORING.md): Grafana sends to Telegram and email.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# Backups to Cloudflare R2 (docs/self-hosting/BACKUPS.md).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
