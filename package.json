{
  "name": "matbex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "dev:all": "docker compose -f docker-compose.dev.yml up -d && npm run db:migrate && (npm run dev:api & npm run dev)",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env db/migrate.mjs status",
    "db:new": "node db/migrate.mjs new",
    "db:types": "node --env-file-if-exists=.env scripts/generate-db-types.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:headings": "node ./scripts/check-heading-hierarchy.cjs",
    "lint:edge-auth": "node ./scripts/check-edge-function-auth.cjs",
    "lint:types-drift": "node --env-file-if-exists=.env scripts/generate-db-types.mjs --check",
    "lint:boundaries": "eslint --config eslint.boundaries.config.js 'src/**/*.{ts,tsx}'",
    "lint:bundle": "size-limit",
    "preview": "vite preview",
    "android": "vite build && npx cap sync android && bash scripts/apply-android-signing.sh && bash scripts/apply-android-kiosk.sh && npx cap run android",
    "android:full": "bash scripts/android-full-run.sh",
    "android:keystore": "bash scripts/generate-android-keystore.sh",
    "android:release": "vite build && npx cap sync android && bash scripts/apply-android-signing.sh && bash scripts/apply-android-kiosk.sh && cd android && ./gradlew assembleRelease",
    "android:release:aab": "vite build && npx cap sync android && bash scripts/apply-android-signing.sh && bash scripts/apply-android-kiosk.sh && cd android && ./gradlew bundleRelease",
    "android:bump": "bash scripts/bump-android-version.sh",
    "android:bump:minor": "bash scripts/bump-android-version.sh minor",
    "android:bump:major": "bash scripts/bump-android-version.sh major",
    "android:release:bump": "npx cap sync android && bash scripts/bump-android-version.sh && vite build && npx cap sync android && bash scripts/apply-android-signing.sh && bash scripts/apply-android-kiosk.sh && cd android && ./gradlew assembleRelease bundleRelease",
    "android:fastlane:beta": "cd fastlane && bundle exec fastlane android beta",
    "android:fastlane:alpha": "cd fastlane && bundle exec fastlane android alpha",
    "android:fastlane:production": "cd fastlane && bundle exec fastlane android production",
    "android:doctor": "bash scripts/android-doctor.sh",
    "android:kiosk": "bash scripts/apply-android-kiosk.sh",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && npm --prefix server run typecheck"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dotlottie/react-player": "^1.6.19",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
