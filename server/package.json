{
  "name": "@matbex/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matbex API: auth, data gateway, storage, realtime, server functions, jobs.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env dist/index.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "keys": "node scripts/generate-keys.mjs",
    "migrate": "node --env-file-if-exists=../.env ../db/migrate.mjs",
    "migrate:status": "node --env-file-if-exists=../.env ../db/migrate.mjs status",
    "migrate:from-supabase": "node scripts/migrate-from-supabase.mjs",
    "import:auth": "node scripts/migrate-from-supabase.mjs --steps auth",
    "smoke": "tsx --env-file-if-exists=../.env scripts/smoke-test.ts",
    "test": "tsx --test functions/pos-sync/eventSchema_test.ts functions/terminal-api/versionGuard_test.ts",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@react-email/components": "0.0.22",
    "ai": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "croner": "^9.0.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "otpauth": "^9.3.5",
    "pdfkit": "^0.15.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "resend": "^4.0.1",
    "stripe": "^18.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.23",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
