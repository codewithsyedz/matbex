# TLS + routing. Certificates are issued automatically for both hostnames.
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

{$API_DOMAIN} {
	encode zstd gzip
	# websockets (/realtime/v1/websocket) are proxied transparently
	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
	request_body {
		max_size 60MB
	}
}
