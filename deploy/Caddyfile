# TLS + routing. Certificates are issued automatically for both hostnames.
#
# Cloudflare sits in front (docs/self-hosting/CLOUDFLARE.md). Caddy only believes a
# client-IP header when the request really comes from a trusted proxy (Cloudflare's
# published ranges by default, https://www.cloudflare.com/ips/). It then passes that
# single resolved address to the API, so rate limits and logs see the real visitor and
# a client talking to the origin directly cannot spoof X-Forwarded-For.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80 {
		header_up X-Forwarded-For {client_ip}
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	# websockets (/realtime/v1/websocket) are proxied transparently
	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
	request_body {
		max_size 60MB
	}
}
