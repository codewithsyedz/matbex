// Grafana Alloy: ships container logs to Loki and forwards OpenTelemetry traces to Tempo.

// ---- Logs: every container of this compose project ------------------------------------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Only this compose project: other containers on the host must not end up in Loki.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = coalesce(sys.env("LOG_PROJECT"), "matbex")
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  forward_to    = [loki.process.json.receiver]
  relabel_rules = discovery.relabel.containers.rules
}

// The API logs JSON (pino): lift level and request id so they can be filtered on.
loki.process "json" {
  stage.match {
    selector = "{service=\"api\"}"

    stage.json {
      expressions = { level = "level", req_id = "reqId" }
    }
    stage.labels {
      values = { level = "" }
    }
    stage.structured_metadata {
      values = { req_id = "" }
    }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---- Traces: OTLP in, Tempo out --------------------------------------------------------
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
    tls {
      insecure = true
    }
  }
}
