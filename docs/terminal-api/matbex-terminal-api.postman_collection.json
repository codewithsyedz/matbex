{
  "info": {
    "_postman_id": "b796f734-4768-4b51-83f6-e7928416150d",
    "name": "Matbex Terminal API",
    "description": "REST API for Android / iOS native POS terminals.\n\nAuth: every request (except POST /pair) requires both `X-Terminal-Key` (from /pair) and `Authorization: Bearer <cashier JWT>` (from Supabase Auth).\n\nAll writes should include a unique `Idempotency-Key` UUID \u2014 replays return the original response.\n\nSee docs/terminal-api.md for full reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-generate a fresh idempotency key per request",
          "pm.variables.set('idempotencyKey', require('uuid').v4 ? require('uuid').v4() : (crypto && crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random()));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Pairing",
      "description": "Initial device enrollment. Owner generates a code in Settings \u2192 POS Terminals.",
      "item": [
        {
          "name": "Pair device (one-time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "X-App-Version",
                "value": "1.0.0"
              },
              {
                "key": "X-Platform",
                "value": "android"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pair",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pair"
              ]
            },
            "description": "Exchange a 6-digit pairing code for a device key. The raw key is returned ONCE \u2014 store it securely (Android Keystore / iOS Keychain). The server only stores its SHA-256 hash.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{pairingCode}}\",\n  \"name\": \"Counter 1\",\n  \"platform\": \"android\",\n  \"app_version\": \"1.0.0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
